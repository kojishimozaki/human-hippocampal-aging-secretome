figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
font.family: sans-serif
font.sans-serif: Arial, Liberation Sans, Helvetica, Nimbus Sans, DejaVu Sans
font.size: 11
axes.titlesize: 12
axes.titleweight: bold
axes.labelsize: 11
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.grid: False
xtick.labelsize: 9
ytick.labelsize: 9
legend.frameon: False
legend.fontsize: 9
mathtext.fontset: custom
# Name an INSTALLED family here. Arial is absent on most Linux boxes and
# mathtext then falls back to DejaVu, mixing two typefaces in one figure.
mathtext.rm: Liberation Sans
mathtext.it: Liberation Sans:italic
mathtext.bf: Liberation Sans:bold
pdf.fonttype: 42
ps.fonttype: 42
figure.facecolor: white
savefig.facecolor: white
